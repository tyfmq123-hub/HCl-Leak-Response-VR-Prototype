      "sha256": "c1743e46faed9909e676baf1ba1f8330f5ee6b6c647813f4d84bc31ac15a3f80"
    },
    {
      "stage": "PPE",
      "cue": "27_GoToFieldEntrance",
      "text": "오른손 에이 버튼을 눌러 현장 진입 전 안전 확인 단계로 이동하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/27_GoToFieldEntrance.mp3",
      "sha256": "eb6a7af8a15cfb8defd063c14c50ff09754d8a863ab409b70fa538b0a4322d75"
    },
    {
      "stage": "PPE",
      "cue": "28_MovingToFieldEntrance",
      "text": "현장 입구로 이동합니다.",
      "audio": "Assets/Resources/TrainingNarration/PPE/28_MovingToFieldEntrance.mp3",
      "sha256": "f1b8f91b568df6c1079eb121ae515f8b0cffddbcb9625a19a94b9334f11e8aed"
    },
    {
      "stage": "PPE",
      "cue": "29_WrongPPEOrder",
      "text": "착용 순서가 올바르지 않습니다. 현재 안내 중인 보호구를 먼저 착용하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/29_WrongPPEOrder.mp3",
      "sha256": "89cdef4a3b83936b69d445e9ba223cb65bbcc376ca8310dadad7f4b6a873ac72"
    },
    {
      "stage": "PPE",
      "cue": "30_WearGlovesFirst",
      "text": "먼저 속장갑을 착용하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/30_WearGlovesFirst.mp3",
      "sha256": "4c1ae1a56bc7b353301c7ae38facdd7a773a57cb53417173abf322b1de92c2dc"
    },
    {
      "stage": "PPE",
      "cue": "31_OuterGlovesAfterRespirator",
      "text": "외부 보호장갑은 호흡 보호구와 안면보호구를 착용한 뒤 착용하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/31_OuterGlovesAfterRespirator.mp3",
      "sha256": "80e21f2a1901c71f54b4684b6bf840d6ca4b3235d5fceeec326acf8d8ceb9db5"
    },
    {
      "stage": "PPE",
      "cue": "32_AlreadyEquipped",
      "text": "이미 착용하거나 준비한 장비입니다.",
      "audio": "Assets/Resources/TrainingNarration/PPE/32_AlreadyEquipped.mp3",
      "sha256": "f032f935c3e9c395acd1a9fd9b65eb435716f1a300caf48ff742b7524a36c864"
    },
    {
      "stage": "PPE",
      "cue": "33_CompleteEssentialPPEFirst",
      "text": "대응 장비를 준비하기 전에 필수 개인보호구 착용을 완료하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/33_CompleteEssentialPPEFirst.mp3",
      "sha256": "11829065f13019fae023ff3a9f97c6ae2832e43ab8205634fa793a0a4b849751"
    },
    {
      "stage": "PPE",
      "cue": "34_MissingPPE",
      "text": "필수 개인보호구가 누락되었습니다. 화이트보드의 준비 순서를 다시 확인하십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/34_MissingPPE.mp3",
      "sha256": "d85344bb12b7011a443eec88a3598bfb9da3494e0218f26ecce4a6be7dd756f5"
    },
    {
      "stage": "PPE",
      "cue": "35_PrepareResponseBagFirst",
      "text": "대응가방 안에 필요한 장비를 모두 수납한 뒤 가방을 챙기십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/35_PrepareResponseBagFirst.mp3",
      "sha256": "7c75d23c30fd7fe5bc1772fd08ec0d65991f6f4eb0f6c8b564a2b370281078a6"
    },
    {
      "stage": "PPE",
      "cue": "36_CheckCurrentRequiredPPE",
      "text": "현재 안내 중인 개인보호구를 확인하십시오.",
