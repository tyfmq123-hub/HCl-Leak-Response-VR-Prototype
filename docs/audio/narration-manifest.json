      "audio": "Assets/Resources/TrainingNarration/PPE/23_PrepareWasteContainer.mp3",
      "sha256": "32608c21014a6cdf5c25cc52614958f6c8bd070a5de2373ef8d19f5c8bdecb14"
    },
    {
      "stage": "PPE",
