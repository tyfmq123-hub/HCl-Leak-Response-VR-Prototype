      "sha256": "05af5c2c735efdb9add2da1a6f398f9478fb6fad7e5a600a5bacd45ac43a05f8"
    },
    {
      "stage": "PPE",
      "cue": "37_GripPackedResponseBag",
      "text": "세 가지 장비를 모두 수납했습니다. 그립 버튼을 한 번 눌러 대응가방을 챙기십시오.",
      "audio": "Assets/Resources/TrainingNarration/PPE/37_GripPackedResponseBag.mp3",
      "sha256": "2b3c93c81a3114e92a893cfdbe35c76e76c24e1edda14d44186e607ad99ecdae"
