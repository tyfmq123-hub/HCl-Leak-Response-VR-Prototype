      "sha256": "1fee0f48a1f6efd74e851c220f8bfe08fb19083864ef336be1ff75f1cf313ab3"
    },
    {
      "stage": "PPE",
      "cue": "05_OutlineShowsSelectable",
      "text": "외곽선이 표시된 장비를 손으로 잡을 수 있습니다.",
