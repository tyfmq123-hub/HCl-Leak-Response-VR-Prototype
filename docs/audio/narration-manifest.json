      "sha256": "205238ecc65d145b6fc730d927f89c8cce5464585b63694fc0a1bc624ac30a51"
    },
    {
      "stage": "PPE",
      "cue": "26_AllFieldPrepComplete",
      "text": "개인보호구와 대응 장비 준비가 모두 완료되었습니다.",
