    usageDescription: "UI\uB97C \uC120\uD0DD\uD558\uAC70\uB098 \uC0C1\uD638\uC791\uC6A9
      \uAC00\uB2A5\uD55C \uC7A5\uCE58\uB97C \uC791\uB3D9\uD560 \uB54C \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    instructionText: "\uAC15\uC870\uB41C {TRIGGER} \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uBCF4\uC2ED\uC2DC\uC624."
